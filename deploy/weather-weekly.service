# 주간 날씨 (타이머가 부르는 일회성 반복 실행)
[Unit]
Description=Weekly Weather - Monday post
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/weather_bot
EnvironmentFile=%h/workspace/weather_bot/.env
Environment=TZ=Asia/Seoul
ExecStart=%h/workspace/weather_bot/deploy/run-weekly.sh
StandardOutput=journal
StandardError=journal
