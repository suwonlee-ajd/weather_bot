# 값 뒤 인라인 주석 금지 — 로더가 값의 일부로 읽음.

# --- Slack ---
# xoxb: OAuth & Permissions / xapp: App-Level Tokens (멘션 봇 전용)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=
# C 로 시작하는 채널 ID — 채널 이름이 아님
SLACK_CHANNEL_ID=C...

# --- 예보 (기상청 공개 페이지, 키 불필요) ---
# 전국 · 수도권 · 강원 · 영서 · 영동 · 충남 · 충북 · 전남 · 전북 · 경남 · 경북 · 제주
REGION=전국
# 비우면 구역 정식 이름
AREA_LABEL=
# surf=지상일기도 | ghmd_s24=24시간 예상
CHART_PRODUCT=surf
CARD_SCALE=2

# --- 문구 (none=예보관 원문, 비용 0 | claude | gemini) ---
WRITER=none
# Gemini 호출 제한 시간(초) — claude 에는 적용되지 않음
WRITER_TIMEOUT_SEC=90
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
# 3.8-flash 는 쓰지 않음 — 이 작업에 90초가 지나도 응답이 없음
GEMINI_MODEL=gemini-3.5-flash

# --- 거절/동의 표정 (유니코드 15.1 이라 구형 클라이언트에서 안 보이면 교체) ---
NO_EMOJI=:head_shaking_horizontally:
YES_EMOJI=:head_shaking_vertically:

# --- 시간대 ---
# 반드시 둠 — 로그 파일명·자정 회전이 이 값을 따름 (POST_AT 은 TZ 와 무관하게 늘 KST).
# 서버가 UTC 면 로그가 9시간 어긋남.
TZ=Asia/Seoul

# --- 실행 (POST_AT 은 KST, 비우면 즉시) ---
POST_AT=08:00
DRY_RUN=false

# --- 로그와 산출물 보존 ---
# logs/{연}/{연.월}/{앱}.{날짜}.log — 멘션 봇만 자정 회전·gz 압축·90일 폐기(loguru).
# 주간 게시·정리 로그는 회전 없이 남아 bin/cleanup.py 가 LOG_KEEP_DAYS 대로 지움
# LOG_DIR 은 저장소 밖으로 옮길 때만. LOG_LEVEL=DEBUG 면 요청 URL·응답 크기가 남음
LOG_DIR=
LOG_LEVEL=INFO
# 산출물 보존 — 0 이면 지우지 않음. 수동 정리는 .venv/bin/python bin/cleanup.py --dry-run 으로 먼저 봄
# 이미지는 data/img/ 한 자리에 모이고 보존 기간만 파일명으로 갈림
# weekly-weather-*.png 우리가 만든 주간 카드 (언제든 다시 만들 수 있음)
CARD_KEEP_DAYS=14
# surf_*.png 기상청 일기도 (기상청도 2일치만 보관해 지나면 못 받음)
CHART_KEEP_DAYS=30
# logs/ 보존일 — bin/cleanup.py(정리 타이머)만 씀. 주간 게시·정리 로그는 이 값으로만 지워짐.
# 멘션 봇 로그의 90일 폐기(loguru)는 이 값과 무관함
LOG_KEEP_DAYS=90

# --- 좀처럼 건드릴 일 없는 것들 (줄을 지우면 아래 기본값. KEY= 처럼 비워 두면 기본값이 아님) ---
# 멘션 봇이 광역 예보·단풍 지도를 들고 있는 시간(초). 시도·동 동네예보는 멘션마다 받음.
# 기상청은 하루 네 번만 갱신해 더 자주 긁을 이유가 없음. 줄이면 그만큼 기상청을 자주 부름
MENTION_CACHE_TTL=3600
# 답이 2초 넘게 걸릴 때 띄우는 로딩 메시지의 이모지(콜론 포함, 예: :loading:). 적으면 확인 없이
# 그대로 씀. 비우면 :loading: · :loading2: · :bearloading: 가운데 워크스페이스에 있는 것을 찾고
# (emoji:read), 없으면 :hourglass_flowing_sand:
LOADING_EMOJI=
# dry-run 산출물이 쌓이는 자리. 실제 게시는 파일을 남기지 않음
DATA_DIR=data
IMG_DIR=img
# WRITER=claude 일 때만. 모델에 얼마나 생각할 시간을 줄지 (low/medium/high)
ANTHROPIC_EFFORT=low
