# 주간 게시 (타이머가 부르는 일회성 실행)
[Unit]
Description=Weekly Weather - Monday post
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ajung/workspace/weather_bot
EnvironmentFile=/home/ajung/workspace/weather_bot/.env
Environment=TZ=Asia/Seoul
ExecStart=/home/ajung/workspace/weather_bot/deploy/run.sh
StandardOutput=journal
StandardError=journal
