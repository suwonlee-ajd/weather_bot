# 멘션 응답 봇 (Socket Mode, 상시 실행) — 인바운드 포트 없이 나가는 WebSocket 연결 하나뿐임.
# User= 없음 — 등록한 계정의 systemd --user 로 돌고 %h 도 그 홈임(deploy/DEPLOY.md §3-A).
[Unit]
Description=Weekly Weather - Slack mention bot (Socket Mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/weather_bot
EnvironmentFile=%h/workspace/weather_bot/.env
Environment=TZ=Asia/Seoul
ExecStart=%h/workspace/weather_bot/deploy/run-mention.sh
Restart=always
RestartSec=10
# 슬랙 연결 끊김은 Bolt 가 재연결함 — Restart 는 프로세스가 죽었을 때만
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
